{
  "name": "deskmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A macOS desktop companion for programmers: Live2D + DeepSeek + native speech.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test scripts/test-*.mjs",
    "eval:memory": "node --experimental-strip-types --no-warnings scripts/eval-memory.mjs --auto",
    "eval:gui": "node --experimental-strip-types --no-warnings scripts/gui-eval.mjs",
    "eval:ax": "node --experimental-strip-types --no-warnings scripts/gui-ax-eval.mjs",
    "eval:verifier": "node --experimental-strip-types --no-warnings scripts/gui-verifier-eval.mjs",
    "smoke:gui-api": "node --experimental-strip-types --no-warnings scripts/gui-react-api-smoke.mjs",
    "smoke:gui": "node --experimental-strip-types --no-warnings scripts/gui-react-smoke.mjs",
    "smoke:watch": "node --experimental-strip-types --no-warnings scripts/gui-watch-smoke.mjs",
    "collect:verifier": "node --experimental-strip-types --no-warnings scripts/gui-verifier-collect.mjs",
    "check:model": "node scripts/check-live2d-model.mjs assets/live2d/hijiki/hijiki.model.json",
    "demo:pass": "node scripts/send-test-event.mjs pass",
    "demo:fail": "node scripts/send-test-event.mjs fail"
  },
  "dependencies": {
    "get-windows": "^10.0.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.3.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "allowScripts": {
    "electron@45.3.0": true,
    "esbuild@0.28.2": true,
    "get-windows@10.0.0": true
  }
}
